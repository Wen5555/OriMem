{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Wen5555/orimem",
  "title": "OriMem",
  "description": "Long-term memory for coding agents in your own Obsidian vault: recall, write-back, capture.",
  "version": "1.0.0-rc.1",
  "repository": {
    "url": "https://github.com/Wen5555/OriMem",
    "source": "github"
  },
  "websiteUrl": "https://github.com/Wen5555/OriMem#readme",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "orimem-mcp",
      "version": "1.0.0rc1",
      "runtimeHint": "uvx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
